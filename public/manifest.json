{
  "manifest_version": 3,
  "name": "Focus Todo New Tab",
  "description": "A minimal translucent todo and focus timer for every new Chrome tab.",
  "version": "1.0.0",
  "permissions": ["alarms", "notifications", "storage"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}

{
  "manifest_version": 3,
  "name": "Focus Todo New Tab",
  "description": "A minimal translucent todo and focus timer for every new Chrome tab.",
  "version": "1.2.0",
  "permissions": [
    "alarms",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}

{
  "manifest_version": 3,
  "name": "Focus Todo New Tab",
  "description": "A minimal translucent todo and focus timer for every new tab (Chrome or Firefox).",
  "version": "1.3.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "focus-todo-new-tab@ramonstaal.github.io",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://api.open-meteo.com/*",
    "https://geocoding-api.open-meteo.com/*",
    "https://api.bigdatacloud.net/*",
    "https://*.workers.dev/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  }
}
